generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["project"]
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  ownerId     String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@map("projects")
  @@schema("project")
}

