{
  "name": "@forgemind/workflow-orchestrator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "prisma generate --schema prisma/schema.prisma && tsx watch src/index.ts",
    "build": "prisma generate --schema prisma/schema.prisma && tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "test:integration": "prisma generate --schema prisma/schema.prisma && vitest run --config vitest.integration.config.ts",
    "dev:worker": "prisma generate --schema prisma/schema.prisma && tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@forgemind/sdk": "workspace:*",
    "@forgemind/shared-auth": "workspace:*",
    "@forgemind/shared-errors": "workspace:*",
    "@forgemind/shared-events": "workspace:*",
    "@forgemind/shared-validation": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prisma": "7.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
